                        <option value="red-counter-mid">Middle Counter</option>
                        <option value="red-freekick">Attacking Free Kick</option>
                        <option value="red-high-press">High Press</option>
                        <option value="red-defend-corner">Defend Corner</option>
                    </optgroup>
                    <optgroup label="Blue Team">
                        <option value="blue-breakaway">Fast Breakaway</option>
                        <option value="blue-overlap-right">Right Overlap</option>
                        <option value="blue-buildup">Goal Kick Build Up</option>
                        <option value="blue-low-block">Low Block</option>
                        <option value="blue-defend-fk">Defend Wide FK</option>
                    </optgroup>
                </select>
            </div>
        </div>

        <!-- Tab 3: Actions & Controls -->
        <div class="tab-content" id="tab-actions">
            <div class="form-row">
                <button id="mode-toggle" class="mode-setup">✏️ Draw Moves: OFF</button>
                <button id="export-btn">📸 Export Seq.</button>
            </div>
            <div class="form-row">
                <button id="flip-board" class="btn-icon">🔃</button>
                <button id="reset-moves">⏪ Tracers</button>
                <button id="reset-formation">🔄 Reset</button>
            </div>
        </div>

