                    <option value="numbers">Show Numbers</option>
                </select>
            </div>
            <div class="form-row">
                <select id="home-formation-select"></select>
                <select id="opp-formation-select"></select>
            </div>
        </div>

        <!-- Tab 2: Scenarios -->
        <div class="tab-content" id="tab-scenarios">
            <div class="form-row">
                <select id="scenario-select" style="border-color: rgba(59, 130, 246, 0.4);">
                    <option value="">-- Select Template --</option>
                    <optgroup label="Red Team">
