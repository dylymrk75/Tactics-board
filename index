                "9v9": { home: [{x:50,y:90,r:'GK'}, {x:25,y:60,r:'LB'}, {x:50,y:65,r:'CB'}, {x:75,y:60,r:'RB'}, {x:30,y:45,r:'LM'}, {x:50,y:40,r:'CM'}, {x:70,y:45,r:'RM'}, {x:40,y:30,r:'CAM'}, {x:60,y:30,r:'ST'}], opp: [{x:50,y:5,r:'GK'}, {x:20,y:15,r:'RB'}, {x:50,y:12,r:'CB'}, {x:80,y:15,r:'LB'}, {x:50,y:25,r:'CDM'}, {x:50,y:35,r:'CAM'}, {x:20,y:45,r:'RW'}, {x:50,y:50,r:'ST'}, {x:80,y:45,r:'LW'}], ball: {x:50,y:8} }
            },
            "blue-low-block": { 
                "11v11": { home: [{x:50,y:85,r:'GK'}, {x:20,y:60,r:'LB'}, {x:40,y:65,r:'CB'}, {x:60,y:65,r:'CB'}, {x:80,y:60,r:'RB'}, {x:25,y:40,r:'LM'}, {x:50,y:40,r:'CM'}, {x:75,y:40,r:'RM'}, {x:30,y:30,r:'CF'}, {x:50,y:25,r:'CAM'}, {x:70,y:30,r:'ST'}], opp: [{x:50,y:8,r:'GK'}, {x:20,y:15,r:'RB'}, {x:35,y:12,r:'CB'}, {x:50,y:12,r:'CB'}, {x:65,y:12,r:'CB'}, {x:80,y:15,r:'LB'}, {x:30,y:22,r:'CDM'}, {x:50,y:20,r:'CM'}, {x:70,y:22,r:'CDM'}, {x:40,y:28,r:'RW'}, {x:60,y:28,r:'LW'}], ball: {x:50,y:28} },
                "9v9": { home: [{x:50,y:85,r:'GK'}, {x:25,y:60,r:'LB'}, {x:50,y:65,r:'CB'}, {x:75,y:60,r:'RB'}, {x:25,y:40,r:'LM'}, {x:50,y:40,r:'CM'}, {x:75,y:40,r:'RM'}, {x:50,y:30,r:'CAM'}, {x:50,y:25,r:'ST'}], opp: [{x:50,y:8,r:'GK'}, {x:25,y:15,r:'RB'}, {x:50,y:12,r:'CB'}, {x:75,y:15,r:'LB'}, {x:35,y:22,r:'CDM'}, {x:65,y:22,r:'CDM'}, {x:25,y:30,r:'RW'}, {x:50,y:35,r:'ST'}, {x:75,y:30,r:'LW'}], ball: {x:50,y:28} }
            },
            "blue-defend-fk": { 
                "11v11": { home: [{x:50,y:80,r:'GK'}, {x:30,y:55,r:'LB'}, {x:50,y:60,r:'CB'}, {x:70,y:55,r:'RB'}, {x:40,y:45,r:'CDM'}, {x:60,y:45,r:'CDM'}, {x:15,y:35,r:'LM'}, {x:35,y:20,r:'CAM'}, {x:45,y:18,r:'RM'}, {x:55,y:18,r:'CF'}, {x:65,y:20,r:'ST'}], opp: [{x:50,y:8,r:'GK'}, {x:25,y:16,r:'RB'}, {x:40,y:15,r:'CB'}, {x:55,y:15,r:'CB'}, {x:70,y:16,r:'LB'}, {x:20,y:25,r:'RM'}, {x:30,y:22,r:'CM'}, {x:50,y:22,r:'CM'}, {x:65,y:25,r:'LM'}, {x:40,y:45,r:'ST'}, {x:60,y:45,r:'ST'}], ball: {x:16,y:33} },
                "9v9": { home: [{x:50,y:80,r:'GK'}, {x:35,y:55,r:'LB'}, {x:50,y:60,r:'CB'}, {x:65,y:55,r:'RB'}, {x:50,y:45,r:'CDM'}, {x:20,y:35,r:'LM'}, {x:45,y:18,r:'RM'}, {x:35,y:20,r:'CAM'}, {x:55,y:18,r:'ST'}], opp: [{x:50,y:8,r:'GK'}, {x:30,y:16,r:'RB'}, {x:50,y:15,r:'CB'}, {x:70,y:16,r:'LB'}, {x:25,y:25,r:'RM'}, {x:45,y:25,r:'CM'}, {x:65,y:25,r:'LM'}, {x:40,y:45,r:'ST'}, {x:60,y:45,r:'ST'}], ball: {x:16,y:33} }
            }
        };

        // --- 2. DOM ELEMENTS ---
        const configSelect = document.getElementById('config-select');
        const labelModeSelect = document.getElementById('label-mode-select');
        const homeFormSelect = document.getElementById('home-formation-select');
        const oppFormSelect = document.getElementById('opp-formation-select');
        const scenarioSelect = document.getElementById('scenario-select');
        const modeToggleBtn = document.getElementById('mode-toggle');
        const exportBtn = document.getElementById('export-btn');
        const flipBtn = document.getElementById('flip-board');
        const resetMovesBtn = document.getElementById('reset-moves');
        const resetFormBtn = document.getElementById('reset-formation');
        const pitch = document.getElementById('pitch');
        const arrowsOverlay = document.getElementById('arrows-overlay');
        
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        let magnets = [];
        let activeMagnet = null;
        let isSetupMode = true;
        let isFlipped = false;
        let labelMode = 'positions';

        // --- 3. UI TAB LOGIC ---
        function switchTab(tabId) {
            tabBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tabId));
            tabContents.forEach(content => content.classList.toggle('active', content.id === `tab-${tabId}`));
        }
        tabBtns.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));

        // --- 4. BOARD LOGIC ---
        function init() {
            labelMode = labelModeSelect.value;
            updateFormationDropdowns();
            loadBoard();
            setupEventListeners();
        }

        function updateFormationDropdowns() {
            const config = configSelect.value;
            homeFormSelect.innerHTML = ''; oppFormSelect.innerHTML = '';
            for (let form in formations[config]) {
                homeFormSelect.appendChild(new Option(`Red: ${form}`, form));
                oppFormSelect.appendChild(new Option(`Blue: ${form}`, form));
            }
        }

        function updateAllLabels() {
            document.querySelectorAll('.magnet.home, .magnet.opp').forEach(el => {
                el.textContent = labelMode === 'numbers' ? el.dataset.num : el.dataset.role;
            });
        }

        function createMagnet(type, id, startX, startY, numLabel, roleLabel) {
            const el = document.createElement('div');
            el.className = `magnet ${type} is-resetting`;
            
            el.style.left = `${startX}%`; el.style.top = `${startY}%`;
            el.dataset.id = id;
            el.dataset.startX = startX; el.dataset.startY = startY;
            el.dataset.currX = startX; el.dataset.currY = startY;

            if (type !== 'ball') {
                el.dataset.num = numLabel;
                el.dataset.role = roleLabel || numLabel;
                el.textContent = labelMode === 'numbers' ? numLabel : el.dataset.role;
            }

            pitch.appendChild(el);
            magnets.push(el);

            const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute('id', `line-${id}`);
            
            let color = 'var(--ball-arrow)'; let marker = 'arrowhead-ball';
            if (type === 'home') { color = 'var(--home-arrow)'; marker = 'arrowhead-home'; }
            if (type === 'opp') { color = 'var(--opp-arrow)'; marker = 'arrowhead-opp'; }

            line.setAttribute('stroke', color);
            line.setAttribute('stroke-width', type === 'ball' ? '3' : '2');
            line.setAttribute('stroke-dasharray', type === 'ball' ? '6,6' : '4,4');
            line.setAttribute('marker-end', `url(#${marker})`);
            line.setAttribute('x1', `${startX}%`); line.setAttribute('y1', `${startY}%`);
            line.setAttribute('x2', `${startX}%`); line.setAttribute('y2', `${startY}%`);
            line.style.opacity = '0';
            
            arrowsOverlay.appendChild(line);
            setTimeout(() => el.classList.remove('is-resetting'), 400);
        }

        function loadBoard() {
            setSetupMode(true); 
            document.querySelectorAll('.magnet, line').forEach(el => el.remove());
            magnets = [];

            const scenarioId = scenarioSelect.value;
            const config = configSelect.value; 

            if (scenarioId && scenarios[scenarioId] && scenarios[scenarioId][config]) {
                const s = scenarios[scenarioId][config];
                s.home.forEach((pos, index) => createMagnet('home', `home-${index}`, pos.x, pos.y, index + 1, pos.r));
                s.opp.forEach((pos, index) => createMagnet('opp', `opp-${index}`, pos.x, pos.y, index + 1, pos.r)); 
                createMagnet('ball', 'football', s.ball.x, s.ball.y, '', '');
            } else {
                const homePositions = formations[config][homeFormSelect.value];
                const oppPositions = formations[config][oppFormSelect.value];
                homePositions.forEach((pos, index) => createMagnet('home', `home-${index}`, pos.x, pos.y, index + 1, pos.r));
                oppPositions.forEach((pos, index) => createMagnet('opp', `opp-${index}`, 100 - pos.x, 100 - pos.y, index + 1, pos.r));
                createMagnet('ball', 'football', 50, 50, '', '');
            }
        }

        function setSetupMode(setup) {
            isSetupMode = setup;
            if (isSetupMode) {
                modeToggleBtn.textContent = "✏️ Draw Moves: OFF";
                modeToggleBtn.classList.remove("mode-moves");
                resetMoves(); 
            } else {
                modeToggleBtn.textContent = "✏️ Draw Moves: ON";
                modeToggleBtn.classList.add("mode-moves");
            }
        }

        function resetMoves() {
            magnets.forEach(m => {
                m.classList.add('is-resetting');
                m.style.left = `${m.dataset.startX}%`; m.style.top = `${m.dataset.startY}%`;
                m.dataset.currX = m.dataset.startX; m.dataset.currY = m.dataset.startY;

                const line = document.getElementById(`line-${m.dataset.id}`);
                line.style.opacity = '0';
                line.setAttribute('x2', `${m.dataset.startX}%`);
                line.setAttribute('y2', `${m.dataset.startY}%`);
                setTimeout(() => m.classList.remove('is-resetting'), 400);
            });
        }

        // --- 5. EXPORT SEQUENCE ---
        async function exportSequence() {
            exportBtn.innerHTML = "⏳ Exporting...";
            exportBtn.disabled = true;

            magnets.forEach(m => m.classList.add('no-transition'));

            // Frame 1
            magnets.forEach(m => {
                m.style.left = `${m.dataset.startX}%`;
                m.style.top = `${m.dataset.startY}%`;
                document.getElementById(`line-${m.dataset.id}`).style.opacity = '0';
            });
            await new Promise(r => setTimeout(r, 150)); 
            const canvas1 = await html2canvas(pitch, { backgroundColor: '#1b4d2e', scale: 2 });

            // Frame 2
            magnets.forEach(m => {
                m.style.left = `${m.dataset.currX}%`;
                m.style.top = `${m.dataset.currY}%`;
                updateArrow(m);
            });
            await new Promise(r => setTimeout(r, 150)); 
            const canvas2 = await html2canvas(pitch, { backgroundColor: '#1b4d2e', scale: 2 });

            magnets.forEach(m => m.classList.remove('no-transition'));

            // Stitch
            const padding = 40;
            const textHeight = 80;
            const width = (canvas1.width * 2) + (padding * 3);
            const height = canvas1.height + (padding * 2) + textHeight;

            const finalCanvas = document.createElement('canvas');
            finalCanvas.width = width;
            finalCanvas.height = height;
            const ctx = finalCanvas.getContext('2d');

            ctx.fillStyle = '#09090b'; 
            ctx.fillRect(0, 0, width, height);

            ctx.fillStyle = '#f8fafc';
            ctx.font = 'bold 44px "Inter", -apple-system, sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText("1. The Scenario", padding + (canvas1.width / 2), padding + 40);
            ctx.fillText("2. The Solution", (padding * 2) + canvas1.width + (canvas2.width / 2), padding + 40);

            ctx.drawImage(canvas1, padding, padding + textHeight);
            ctx.drawImage(canvas2, (padding * 2) + canvas1.width, padding + textHeight);

            const link = document.createElement('a');
            link.download = `Tactics-Export-${Date.now()}.png`;
            link.href = finalCanvas.toDataURL('image/png');
            link.click();

            exportBtn.innerHTML = "📸 Export Seq.";
            exportBtn.disabled = false;
        }

        // --- 6. EVENT LISTENERS ---
        function setupEventListeners() {
            labelModeSelect.addEventListener('change', (e) => { labelMode = e.target.value; updateAllLabels(); });
            configSelect.addEventListener('change', () => { updateFormationDropdowns(); loadBoard(); });
            homeFormSelect.addEventListener('change', () => { scenarioSelect.value = ""; loadBoard(); });
            oppFormSelect.addEventListener('change', () => { scenarioSelect.value = ""; loadBoard(); });
            
            scenarioSelect.addEventListener('change', () => {
                if(scenarioSelect.value !== "") switchTab('actions'); 
                loadBoard();
            });
            
            resetFormBtn.addEventListener('click', loadBoard);
            resetMovesBtn.addEventListener('click', resetMoves);
            modeToggleBtn.addEventListener('click', () => setSetupMode(!isSetupMode));
            exportBtn.addEventListener('click', exportSequence);

            flipBtn.addEventListener('click', () => {
                isFlipped = !isFlipped;
                pitch.classList.toggle('flipped', isFlipped);
            });

            pitch.addEventListener('pointerdown', (e) => {
                if (e.target.classList.contains('magnet')) {
                    activeMagnet = e.target;
                    activeMagnet.setPointerCapture(e.pointerId);
                }
            });

            pitch.addEventListener('pointermove', (e) => {
                if (!activeMagnet) return;
                const rect = pitch.getBoundingClientRect();
                let rawX = ((e.clientX - rect.left) / rect.width) * 100;
                let rawY = ((e.clientY - rect.top) / rect.height) * 100;
                let x = isFlipped ? 100 - rawX : rawX;
                let y = isFlipped ? 100 - rawY : rawY;
                x = Math.max(0, Math.min(x, 100));
                y = Math.max(0, Math.min(y, 100));

                activeMagnet.style.left = `${x}%`; activeMagnet.style.top = `${y}%`;
                activeMagnet.dataset.currX = x; activeMagnet.dataset.currY = y;

                if (isSetupMode) {
                    activeMagnet.dataset.startX = x; activeMagnet.dataset.startY = y;
                    const line = document.getElementById(`line-${activeMagnet.dataset.id}`);
                    line.setAttribute('x1', `${x}%`); line.setAttribute('y1', `${y}%`);
                    line.setAttribute('x2', `${x}%`); line.setAttribute('y2', `${y}%`);
                    line.style.opacity = '0';
                } else {
                    updateArrow(activeMagnet);
                }
            });

            pitch.addEventListener('pointerup', (e) => {
                if (activeMagnet) { activeMagnet.releasePointerCapture(e.pointerId); activeMagnet = null; }
            });
            pitch.addEventListener('dragstart', e => e.preventDefault());
        }

        function updateArrow(magnet) {
            const line = document.getElementById(`line-${magnet.dataset.id}`);
            const dx = magnet.dataset.currX - magnet.dataset.startX;
            const dy = magnet.dataset.currY - magnet.dataset.startY;
            if ((dx * dx) + (dy * dy) > 0.5) {
                line.setAttribute('x2', `${magnet.dataset.currX}%`);
                line.setAttribute('y2', `${magnet.dataset.currY}%`);
                line.style.opacity = '1';
            } else { line.style.opacity = '0'; }
        }

        init();
    </script>
