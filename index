                    <marker id="arrowhead-opp" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><polygon points="0 0, 6 3, 0 6" fill="var(--opp-arrow)" /></marker>
                    <marker id="arrowhead-ball" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><polygon points="0 0, 6 3, 0 6" fill="var(--ball-arrow)" /></marker>
                </defs>
            </svg>
        </div>
    </div>

    <div class="bottom-panel">
        
        <div class="tab-header">
            <div class="tab-btn active" data-tab="teams">Squads</div>
            <div class="tab-btn" data-tab="scenarios">Tactics</div>
            <div class="tab-btn" data-tab="actions">Actions</div>
        </div>

        <!-- Tab 1: Teams & Formations -->
